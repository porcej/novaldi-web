---
import { site } from '../content/site';
import Button from './Button.astro';

const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const { applicationsOpen } = site.session;
---

<header
  class:list={[
    'animate-settle z-50 border-b border-white/10',
    isHome ? 'absolute inset-x-0 top-0 bg-transparent' : 'sticky top-0 bg-navy',
  ]}
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 md:h-[4.25rem] md:px-8">
    <a href="/" class="flex items-center gap-3 text-white">
      <img
        src="/images/ldi-logo.jpg"
        alt=""
        width="40"
        height="40"
        class="h-9 w-9 rounded-full ring-2 ring-gold/80 md:h-10 md:w-10"
      />
      <span class="font-display text-lg font-bold uppercase tracking-wide md:text-xl">
        {site.shortName}
      </span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Primary">
      {
        site.nav.map((item) => {
          const active = pathname === item.href || pathname.startsWith(`${item.href}/`);
          return (
            <a
              href={item.href}
              class:list={[
                'font-display text-[0.95rem] font-semibold uppercase tracking-[0.12em] transition',
                active ? 'text-gold' : 'text-white/80 hover:text-gold',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
      {
        applicationsOpen ? (
          <Button href={site.registerUrl} variant="primary" external class="!px-5 !py-2 !text-[0.95rem]">
            Register
          </Button>
        ) : (
          <Button href="/contact" variant="primary" class="!px-5 !py-2 !text-[0.95rem]">
            Contact
          </Button>
        )
      }
    </nav>

    <details class="relative lg:hidden">
      <summary
        class="list-none cursor-pointer rounded border border-white/30 px-3 py-1.5 font-display text-sm font-semibold uppercase tracking-wider text-white marker:content-none [&::-webkit-details-marker]:hidden"
      >
        Menu
      </summary>
      <div class="absolute right-0 z-50 mt-2 w-52 overflow-hidden rounded border border-navy/10 bg-white py-1 shadow-xl">
        {
          site.nav.map((item) => (
            <a
              href={item.href}
              class="block px-4 py-2.5 font-display text-sm font-semibold uppercase tracking-wide text-navy hover:bg-surface"
            >
              {item.label}
            </a>
          ))
        }
        {
          applicationsOpen ? (
            <a
              href={site.registerUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mx-3 my-2 block rounded bg-gold px-4 py-2 text-center font-display text-sm font-semibold uppercase tracking-wide text-navy"
            >
              Register
            </a>
          ) : (
            <a
              href="/contact"
              class="mx-3 my-2 block rounded bg-gold px-4 py-2 text-center font-display text-sm font-semibold uppercase tracking-wide text-navy"
            >
              Contact
            </a>
          )
        }
      </div>
    </details>
  </div>
</header>
