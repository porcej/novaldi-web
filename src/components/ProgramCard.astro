---
interface Props {
  title: string;
  shortTitle?: string;
  audience: string;
  focus: string;
  href?: string;
}

const { title, shortTitle, audience, focus, href } = Astro.props;
---

<article>
  {
    shortTitle && (
      <p class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-gold-dark">
        {shortTitle}
      </p>
    )
  }
  <h3 class="mt-2 font-display text-2xl font-bold uppercase leading-tight tracking-wide text-navy md:text-[1.75rem]">
    {
      href ? (
        <a href={href} class="hover:text-navy-mid">
          {title}
        </a>
      ) : (
        title
      )
    }
  </h3>
  <div class="mt-4 h-1 w-12 bg-gold" aria-hidden="true"></div>
  <p class="mt-5 text-[1.05rem] leading-relaxed text-muted">
    <span class="font-semibold text-ink">Audience.</span>
    {' '}{audience}
  </p>
  <p class="mt-3 text-[1.05rem] leading-relaxed text-muted">
    <span class="font-semibold text-ink">Focus.</span>
    {' '}{focus}
  </p>
</article>
