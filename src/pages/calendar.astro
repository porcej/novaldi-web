---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { site } from '../content/site';
---

<BaseLayout title="Calendar" description={`Upcoming ${site.shortName} dates and events.`}>
  <Hero title="Calendar" lead={`Upcoming ${site.shortName} dates and events.`} />

  <section class="bg-white py-12 md:py-16">
    <div class="mx-auto max-w-6xl px-5 md:px-8">
      <p id="calendar-status" class="text-lg text-muted" role="status">Loading calendar…</p>
      <div id="calendar-frame" class="hidden border border-navy/10 shadow-sm"></div>
    </div>
  </section>
</BaseLayout>

<script>
  const status = document.querySelector<HTMLElement>('#calendar-status')!;
  const frameWrap = document.querySelector<HTMLElement>('#calendar-frame')!;

  async function loadCalendar() {
    try {
      const response = await fetch('/api/calendar', { headers: { Accept: 'application/json' } });
      const data = (await response.json()) as { url?: string | null };
      if (!response.ok) throw new Error();

      if (data.url) {
        const iframe = document.createElement('iframe');
        iframe.src = data.url;
        iframe.title = 'NVFR LDI calendar';
        iframe.className = 'block h-[600px] w-full md:h-[760px]';
        iframe.style.border = '0';
        frameWrap.replaceChildren(iframe);
        frameWrap.classList.remove('hidden');
        status.remove();
      } else {
        status.textContent = 'The calendar has not been published yet. Please check back soon.';
      }
    } catch {
      status.textContent = 'The calendar could not be loaded. Please try again later.';
    }
  }

  loadCalendar();
</script>
