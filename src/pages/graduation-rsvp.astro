---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { site } from '../content/site';
import { rsvpLimits } from '../content/rsvp';

const fieldClass =
  'mt-2 block w-full rounded border border-navy/20 bg-white px-4 py-3 text-base text-ink shadow-sm focus:border-navy focus:outline-none focus:ring-2 focus:ring-gold';
const labelClass = 'font-display text-lg font-semibold uppercase tracking-wide text-navy';
---

<BaseLayout
  title="Graduation RSVP"
  description={`RSVP for the ${site.shortName} ${site.session.year} graduation.`}
>
  <Hero
    title="Graduation RSVP"
    lead={`Let us know who will be joining you to celebrate the ${site.session.year} graduating class.`}
  />

  <section class="bg-white py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-5 md:px-8">
      <div class="max-w-2xl">
        <div
          id="rsvp-success"
          class="hidden border-l-4 border-gold bg-surface px-6 py-8"
          role="status"
          tabindex="-1"
        >
          <h2 class="font-display text-3xl font-bold uppercase tracking-wide text-navy">
            Thank you!
          </h2>
          <p class="mt-3 text-lg leading-relaxed text-muted">
            Your RSVP has been received. If anything changes, email{' '}
            <a class="font-semibold text-navy underline" href={`mailto:${site.email}`}>{site.email}</a>.
          </p>
        </div>

        <form id="rsvp-form" method="post" action="/api/rsvp" class="space-y-8" novalidate>
          <div
            id="rsvp-error"
            class="hidden border-l-4 border-red-600 bg-red-50 px-4 py-3 text-red-800"
            role="alert"
          >
          </div>

          <div>
            <label for="name" class={labelClass}>Name</label>
            <input
              id="name"
              name="name"
              type="text"
              required
              maxlength={rsvpLimits.nameMaxLength}
              autocomplete="name"
              class={fieldClass}
            />
          </div>

          <div>
            <label for="guests" class={labelClass}>Number of guests attending</label>
            <p class="mt-1 text-sm text-muted">Enter 0 if no guests will be joining you.</p>
            <input
              id="guests"
              name="guests"
              type="number"
              required
              min="0"
              max={rsvpLimits.maxGuests}
              step="1"
              inputmode="numeric"
              class:list={[fieldClass, 'max-w-[10rem]']}
            />
          </div>

          <fieldset>
            <legend class={labelClass}>Do you or your guests need accommodations?</legend>
            <p class="mt-1 text-sm text-muted">
              For example, accessibility, mobility, seating, or dietary needs.
            </p>
            <div class="mt-3 flex gap-8">
              <label class="flex items-center gap-2 text-lg">
                <input type="radio" name="accommodations" value="no" required class="h-5 w-5 accent-navy" />
                No
              </label>
              <label class="flex items-center gap-2 text-lg">
                <input type="radio" name="accommodations" value="yes" required class="h-5 w-5 accent-navy" />
                Yes
              </label>
            </div>
          </fieldset>

          <div id="details-field" class="hidden">
            <label for="accommodationDetails" class={labelClass}>Accommodation details</label>
            <p class="mt-1 text-sm text-muted">Tell us what you need so we can plan ahead.</p>
            <textarea
              id="accommodationDetails"
              name="accommodationDetails"
              rows="4"
              maxlength={rsvpLimits.detailsMaxLength}
              class={fieldClass}></textarea>
          </div>

          <div class="absolute -left-[9999px]" aria-hidden="true">
            <label for="company">Company</label>
            <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <button
            type="submit"
            class="inline-flex items-center justify-center bg-gold px-8 py-3 font-display text-lg font-semibold uppercase tracking-wide text-navy shadow-sm transition-colors hover:bg-gold-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold disabled:opacity-60"
          >
            Submit RSVP
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#rsvp-form')!;
  const success = document.querySelector<HTMLElement>('#rsvp-success')!;
  const errorBox = document.querySelector<HTMLElement>('#rsvp-error')!;
  const detailsField = document.querySelector<HTMLElement>('#details-field')!;
  const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

  function showError(message: string) {
    errorBox.textContent = message;
    errorBox.classList.remove('hidden');
    errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function showSuccess() {
    form.classList.add('hidden');
    success.classList.remove('hidden');
    success.focus();
  }

  function syncDetails() {
    const needs = form.querySelector<HTMLInputElement>('input[name="accommodations"]:checked')?.value === 'yes';
    detailsField.classList.toggle('hidden', !needs);
  }

  const params = new URLSearchParams(window.location.search);
  if (params.get('submitted') === '1') showSuccess();
  else if (params.get('error')) showError(params.get('error')!);

  form.addEventListener('change', syncDetails);
  syncDetails();

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorBox.classList.add('hidden');

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    submitButton.disabled = true;
    submitButton.textContent = 'Submitting…';
    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      const result = (await response.json().catch(() => ({}))) as { ok?: boolean; error?: string };
      if (response.ok && result.ok) showSuccess();
      else showError(result.error ?? 'We could not save your RSVP. Please try again.');
    } catch {
      showError('Network error. Please check your connection and try again.');
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = 'Submit RSVP';
    }
  });
</script>
